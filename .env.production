# ==============================================================================
# Production Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=https://your-production-frontend-url.com

# PostgreSQL Database (Neon / Supabase / Render / AWS RDS)
DATABASE_URL="postgresql://username:password@production-host:5432/emergency_ambulance_prod?schema=public&sslmode=require"

# Upstash Redis / Managed Redis for Caching & State
REDIS_URL="rediss://default:password@your-redis-instance.upstash.io:6379"
REDIS_ENABLED=true

# Production Authentication & JWT Secrets (crypto.randomBytes(64).toString('hex'))
JWT_ACCESS_SECRET=replace_with_strong_production_access_secret_hex_string
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth / GCP Social Login Production Credentials
GOOGLE_CLIENT_ID=production_gcp_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=production_gcp_client_secret

# Cloudinary Production File Storage
CLOUDINARY_CLOUD_NAME=production_cloudinary_cloud_name
CLOUDINARY_API_KEY=production_cloudinary_api_key
CLOUDINARY_API_SECRET=production_cloudinary_api_secret

# Transactional Email (Resend / SendGrid / AWS SES)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM="Emergency Ambulance Dispatch <alerts@yourdomain.com>"

# Production Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_live_replace_with_actual_stripe_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_actual_stripe_live_webhook_secret

# Production Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
