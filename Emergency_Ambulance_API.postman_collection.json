    {
      "name": "6. Trip Dispatch & State Machine (FSM)",
      "item": [
        {
          "name": "Dispatch Ambulance (Nearest Auto-Match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.collectionVariables.set('tripId', res.data.id);",
                  "  console.log('✅ Captured tripId:', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emergencyRequestId\": \"{{emergencyId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips/dispatch",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "dispatch"]
            }
          }
        },
        {
          "name": "Get Active Ongoing Trip",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/trips/active",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "active"]
            }
          }
        },
        {
          "name": "Get Trip Details with Audit Trail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}"]
            }
          }
        },
        {
          "name": "Advance Milestone 1: EN_ROUTE_PICKUP",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EN_ROUTE_PICKUP\",\n  \"latitude\": 23.8010,\n  \"longitude\": 90.4100,\n  \"note\": \"Unit rolling with sirens\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "status"]
            }
          }
        },
        {
          "name": "Advance Milestone 2: PATIENT_PICKED_UP",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PATIENT_PICKED_UP\",\n  \"latitude\": 23.7937,\n  \"longitude\": 90.4066,\n  \"note\": \"Patient stabilized in ICU vehicle\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "status"]
            }
          }
        },
        {
          "name": "Advance Milestone 3: EN_ROUTE_HOSPITAL",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EN_ROUTE_HOSPITAL\",\n  \"latitude\": 23.7700,\n  \"longitude\": 90.3900,\n  \"note\": \"Transiting to destination hospital ER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trips/{{tripId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["trips", "{{tripId}}", "status"]
            }
          }
        },
        {
          "name": "Advance Milestone 4: ARRIVED_HOSPITAL",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{driverToken}}" }
            ],
            "body": {
