          "name": "Upload Avatar",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "avatar", "type": "file", "src": "" }]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me", "avatar"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Hospitals & Emergency Beds",
      "item": [
        {
          "name": "List Hospitals (Filters & Search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospitals?page=1&limit=10&hasIcu=true&search=Dhaka",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "hasIcu", "value": "true" },
                { "key": "search", "value": "Dhaka" }
              ]
            }
          }
        },
        {
          "name": "Create Hospital (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  pm.collectionVariables.set('hospitalId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"National Institute of Cardiovascular Diseases\",\n  \"address\": \"Sher-e-Bangla Nagar, Dhaka 1207\",\n  \"latitude\": 23.7712,\n  \"longitude\": 90.3688,\n  \"contactPhone\": \"+88029122560\",\n  \"emergencyBedsTotal\": 40,\n  \"emergencyBedsAvailable\": 14,\n  \"hasIcu\": true,\n  \"icuBedsAvailable\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospitals",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals"]
            }
          }
        },
        {
          "name": "Get Hospital By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/hospitals/{{hospitalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals", "{{hospitalId}}"]
            }
          }
        },
        {
          "name": "Update Available Beds (Admin)",
          "request": {
            "method": "PATCH",
