              "raw": "{\n  \"emergencyBedsAvailable\": 8,\n  \"icuBedsAvailable\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hospitals/{{hospitalId}}/beds",
              "host": ["{{baseUrl}}"],
              "path": ["hospitals", "{{hospitalId}}", "beds"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Ambulances & Fleet",
      "item": [
        {
          "name": "Find Nearby Ambulances (GPS & ETA Calculation)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/ambulances/nearby?latitude=23.7944&longitude=90.4042&radiusKm=25",
              "host": ["{{baseUrl}}"],
              "path": ["ambulances", "nearby"],
              "query": [
                { "key": "latitude", "value": "23.7944" },
                { "key": "longitude", "value": "90.4042" },
                { "key": "radiusKm", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "List Ambulances (Fleet)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/ambulances?page=1&limit=10&isOperational=true",
              "host": ["{{baseUrl}}"],
