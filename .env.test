# ==============================================================================
# Test Environment Configuration
# ==============================================================================
NODE_ENV=test
PORT=5001
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# PostgreSQL Database for automated testing
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emergency_ambulance_test?schema=public"

# Test Authentication & JWT Secrets
JWT_ACCESS_SECRET=test_jwt_access_secret_key_at_least_32_characters_12345
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_at_least_32_characters_12345
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=4

# Google OAuth Stub
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret

# Stripe Test Mock
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret

# Relaxed Rate Limiting for tests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
