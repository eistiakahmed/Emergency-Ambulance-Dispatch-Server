# ==============================================================================
# Development Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Local / Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emergency_ambulance_dev?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=dev_jwt_access_super_secret_key_at_least_32_characters_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_super_secret_key_at_least_32_characters_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth / GCP Social Login
GOOGLE_CLIENT_ID=your_dev_google_client_id
GOOGLE_CLIENT_SECRET=your_dev_google_client_secret

# Stripe Payment Gateway (Sandbox / Test Mode)
STRIPE_SECRET_KEY=sk_test_dev_dummy_stripe_key_placeholder
STRIPE_WEBHOOK_SECRET=whsec_dev_dummy_webhook_secret_placeholder

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
