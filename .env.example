# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emergency_ambulance_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long_12345
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth / GCP Social Login
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder_for_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_stripe_webhook_signing

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
