# ==============================================================================
# Application Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# ==============================================================================
# Database Connection (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emergency_ambulance_db?schema=public"

# ==============================================================================
# Caching & Temporary State (Redis)
# ==============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED=false

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long_12345
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ==============================================================================
# Google OAuth / GCP Social Login
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==============================================================================
# File Storage (Cloudinary)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================================
# Transactional Email (Nodemailer / Resend)
# ==============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Emergency Dispatch System <noreply@emergency.com>"

# ==============================================================================
# Payment Gateway (Stripe & bKash)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_placeholder_for_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_stripe_webhook_signing

BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/bkash/callback

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
